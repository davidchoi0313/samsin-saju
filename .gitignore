*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── 테스트·커버리지 캐시 ──
.pytest_cache/
pytest-cache-files-*/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── 가상환경 ──
.venv/
venv/
env/
ENV/

# ── 백업·임시 파일 ──
*.bak
*.bak*
*.tmp
*.swp
*~

# ── OS 생성 파일 ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── 에디터/IDE ──
.idea/
.vscode/
*.iml

# ── 엔진 산출물(QA 캐시) ──
